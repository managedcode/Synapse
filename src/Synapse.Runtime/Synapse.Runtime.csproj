<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ManagedCode.Synapse.Runtime</RootNamespace>
    <AssemblyName>ManagedCode.Synapse.Runtime</AssemblyName>
    <Description>Local Synapse runtime composition and native process boundary.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Synapse.Contracts/Synapse.Contracts.csproj" />
    <PackageReference Include="ZoneTree" />
  </ItemGroup>

  <!-- ADR-006 and ADR-012: the Rust CPU kernel and GPU libraries are built with the pinned toolchain and shipped
       next to the assemblies. -->
  <PropertyGroup>
    <SynapseNativeRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'native'))</SynapseNativeRoot>
    <SynapseHomebrewCargo>/opt/homebrew/opt/rustup/bin/cargo</SynapseHomebrewCargo>
    <SynapseCargo Condition="'$(SynapseCargo)' == '' and Exists('$(SynapseHomebrewCargo)')">$(SynapseHomebrewCargo)</SynapseCargo>
    <SynapseCargo Condition="'$(SynapseCargo)' == ''">cargo</SynapseCargo>
    <SynapseNativeKernelFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">synapse_kernels.dll</SynapseNativeKernelFile>
    <SynapseNativeKernelFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">libsynapse_kernels.dylib</SynapseNativeKernelFile>
    <SynapseNativeKernelFile Condition="'$(SynapseNativeKernelFile)' == ''">libsynapse_kernels.so</SynapseNativeKernelFile>
    <SynapseNativeKernelPath>$(SynapseNativeRoot)target/release/$(SynapseNativeKernelFile)</SynapseNativeKernelPath>
    <SynapseNativeGpuFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">synapse_gpu.dll</SynapseNativeGpuFile>
    <SynapseNativeGpuFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">libsynapse_gpu.dylib</SynapseNativeGpuFile>
    <SynapseNativeGpuFile Condition="'$(SynapseNativeGpuFile)' == ''">libsynapse_gpu.so</SynapseNativeGpuFile>
    <SynapseNativeGpuPath>$(SynapseNativeRoot)target/release/$(SynapseNativeGpuFile)</SynapseNativeGpuPath>
    <SynapseCargoCommand>"$(SynapseCargo)" build --release --locked --manifest-path "$(SynapseNativeRoot)Cargo.toml" -p synapse-kernels -p synapse-gpu</SynapseCargoCommand>
  </PropertyGroup>
  <ItemGroup>
    <SynapseNativeKernelInput Include="$(SynapseNativeRoot)synapse-kernels/**/*.rs" />
    <SynapseNativeKernelInput Include="$(SynapseNativeRoot)synapse-gpu/**/*.rs;$(SynapseNativeRoot)synapse-gpu/**/*.metal;$(SynapseNativeRoot)synapse-gpu/Cargo.toml" />
    <SynapseNativeKernelInput Include="$(SynapseNativeRoot)synapse-kernels/Cargo.toml;$(SynapseNativeRoot)Cargo.toml;$(SynapseNativeRoot)Cargo.lock" />
  </ItemGroup>
  <Target
    Name="BuildSynapseNativeKernels"
    Inputs="@(SynapseNativeKernelInput)"
    Outputs="$(SynapseNativeKernelPath);$(SynapseNativeGpuPath)">
    <Exec
      Condition="'$(SynapseCargo)' == '$(SynapseHomebrewCargo)'"
      Command="$(SynapseCargoCommand)"
      EnvironmentVariables="PATH=/opt/homebrew/opt/rustup/bin:$(PATH)" />
    <Exec Condition="'$(SynapseCargo)' != '$(SynapseHomebrewCargo)'" Command="$(SynapseCargoCommand)" />
    <Touch Files="$(SynapseNativeKernelPath);$(SynapseNativeGpuPath)" />
  </Target>
  <Target
    Name="IncludeSynapseNativeKernels"
    BeforeTargets="AssignTargetPaths"
    DependsOnTargets="BuildSynapseNativeKernels">
    <ItemGroup>
      <None
        Include="$(SynapseNativeKernelPath)"
        Link="$(SynapseNativeKernelFile)"
        CopyToOutputDirectory="PreserveNewest"
        Visible="false" />
      <None
        Include="$(SynapseNativeGpuPath)"
        Link="$(SynapseNativeGpuFile)"
        CopyToOutputDirectory="PreserveNewest"
        Visible="false" />
    </ItemGroup>
  </Target>
</Project>
